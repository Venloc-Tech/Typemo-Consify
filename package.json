{
  "name": "typemo-docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sync": "bun scripts/sync-docs.ts",
    "dev": "bun run sync && consify dev",
    "build": "bun run sync && consify build",
    "start": "consify start",
    "check": "consify check",
    "check:twoslash": "node scripts/check-twoslash.ts",
    "typecheck": "consify typegen && tsc --noEmit"
  },
  "dependencies": {
    "@consify/cli": "^1.0.5",
    "@consify/core": "^1.0.5",
    "@consify/docs": "^1.0.5",
    "isbot": "^5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@types/node": "24",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "6.0.3",
    "vite": "8.3.0"
  }
}
